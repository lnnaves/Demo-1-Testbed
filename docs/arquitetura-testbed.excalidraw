    {"id":"label-rules","type":"text","x":1040,"y":88,"width":247,"height":69,"angle":0,"strokeColor":"#c2255c","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"roundness":null,"seed":118,"version":1,"versionNonce":118,"isDeleted":false,"boundElements":null,"updated":1790700000000,"link":null,"locked":false,"text":"Regras de\norquestração","fontSize":25,"fontFamily":1,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Regras de\norquestração","autoResize":false,"lineHeight":1.25},
    {"id":"box-rules","type":"rectangle","x":1047,"y":167,"width":694,"height":574,"angle":0,"strokeColor":"#c2255c","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":3,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"roundness":{"type":3},"seed":119,"version":1,"versionNonce":119,"isDeleted":false,"boundElements":null,"updated":1790700000000,"link":null,"locked":false},
    {"id":"text-rules","type":"text","x":1065,"y":210,"width":655,"height":520,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"roundness":null,"seed":120,"version":1,"versionNonce":120,"isDeleted":false,"boundElements":null,"updated":1790700000000,"link":null,"locked":false,"text":"- testbed/config.py: lê e valida scripts/config.yml.\n- testbed/network.py: cria os containers, configura\n  rede ad hoc BATMAN-adv e atribui IPs em bat0.\n- testbed/runner.py: executa um modo por vez:\n\n  1. Unicast: um sender e um receiver; usa o IP\n     do receiver como destino do sender.\n\n  2. Broadcast: um sender e todos os receivers\n     configurados; usa o IP de broadcast como\n     destino do sender. Cada receiver mantém seu IP.\n\n- testbed/metrics.py: tcpdump no sender para\n  capturar UDP na porta configurada.\n\n- Gera PCAP, CSV e JSON; encerra processos,\n  captura e rede (limpeza no finally).","fontSize":20,"fontFamily":1,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"- testbed/config.py: lê e valida scripts/config.yml.\n- testbed/network.py: cria os containers, configura\n  rede ad hoc BATMAN-adv e atribui IPs em bat0.\n- testbed/runner.py: executa um modo por vez:\n\n  1. Unicast: um sender e um receiver; usa o IP\n     do receiver como destino do sender.\n\n  2. Broadcast: um sender e todos os receivers\n     configurados; usa o IP de broadcast como\n     destino do sender. Cada receiver mantém seu IP.\n\n- testbed/metrics.py: tcpdump no sender para\n  capturar UDP na porta configurada.\n\n- Gera PCAP, CSV e JSON; encerra processos,\n  captura e rede (limpeza no finally).","autoResize":false,"lineHeight":1.25},
    {"id":"label-config","type":"text","x":2122,"y":174,"width":270,"height":47,"angle":0,"strokeColor":"#1971c2","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"roundness":null,"seed":121,"version":1,"versionNonce":121,"isDeleted":false,"boundElements":null,"updated":1790700000000,"link":null,"locked":false,"text":"scripts/config.yml","fontSize":30,"fontFamily":1,"textAlign":"center","verticalAlign":"top","containerId":null,"originalText":"scripts/config.yml","autoResize":false,"lineHeight":1.25},
