#!/usr/bin/env python3
"""Minimal replaceable sender model.

This file is not a protocol. It only demonstrates the operational contract
expected by the testbed: receive --destination/--port, open its own socket and
run in foreground until it finishes. Replace it with the real protocol
executable; the testbed never interprets what is sent or printed.
"""

import argparse
import ipaddress
import socket
import sys


def parse_arguments():
    parser = argparse.ArgumentParser()
    parser.add_argument("--destination", required=True)
    parser.add_argument("--port", required=True, type=int)
    return parser.parse_args()


def tx(sock, destination, port):
    """Send a single minimal datagram so the platform can be smoke tested."""
    sock.sendto(b"\x00", (destination, port))


def is_ipv4_address(value):
    try:
        return ipaddress.ip_address(value).version == 4
    except ValueError:
        return False


def main():
    args = parse_arguments()

    if not 1 <= args.port <= 65535:
        print("Invalid port", file=sys.stderr)
        return 2

    if not is_ipv4_address(args.destination):
        print("Invalid destination IPv4 address", file=sys.stderr)
        return 2

    try:
        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sock:
            # This option only permits sending to a broadcast destination. It does
            # not choose the scenario; config.yml and runner.py choose the IP.
            sock.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
            tx(sock, args.destination, args.port)

        print(f"Sender finished for {args.destination}:{args.port}", flush=True)
        return 0

    except OSError as error:
        print(f"Sender error: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
