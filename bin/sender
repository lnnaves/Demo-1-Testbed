#!/usr/bin/env python3

import argparse
import socket
import sys
import time


def parse_arguments():
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--mode",
        required=True,
        choices=("unicast", "broadcast"),
    )
    parser.add_argument("--destination", required=True)
    parser.add_argument("--port", required=True, type=int)
    parser.add_argument("--count", required=True, type=int)
    return parser.parse_args()


def tx(sock, destination, port, count):
    for sequence in range(1, count + 1):
        timestamp_ns = time.time_ns()
        payload = f"sequence={sequence};timestamp_ns={timestamp_ns}".encode()

        sock.sendto(payload, (destination, port))

        print(
            f"TX {sequence}: {len(payload)} bytes to "
            f"{destination}:{port}",
            flush=True,
        )

        time.sleep(0.01)


def main():
    args = parse_arguments()

    if not 1 <= args.port <= 65535:
        print("Invalid port", file=sys.stderr)
        return 2

    if args.count <= 0:
        print("Count must be greater than zero", file=sys.stderr)
        return 2

    try:
        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sock:
            if args.mode == "broadcast":
                sock.setsockopt(
                    socket.SOL_SOCKET,
                    socket.SO_BROADCAST,
                    1,
                )

            tx(
                sock,
                args.destination,
                args.port,
                args.count,
            )

        print("Transmission completed", flush=True)
        return 0

    except OSError as error:
        print(f"Sender error: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
