FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        python3 \
        iproute2 \
        iputils-ping \
        iw \
        wireless-tools \
        batctl \
        ebtables \
        kmod \
        procps \
        tcpdump \
        libstdc++6 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

CMD ["/bin/bash"]
